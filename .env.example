# Contabo / production — bu dosyayı sunucuda `.env` olarak kopyala
ACCESS_CODE=HSD_FIRAT_2026
ADMIN_PASSWORD=admin_hsd_2026
SESSION_HOURS=3
PRACTICE_MINUTES=15
SUBMIT_RATE_LIMIT=30

# Nginx tek origin servis ediyor; * veya domain yaz
CORS_ORIGIN=*

# Web arayüz portu (Contabo güvenlik duvarında aç)
HTTP_PORT=80

# Aynı makinede nginx reverse proxy kullanıyorsan boş bırak
# Ayrı API domain’in varsa örn: https://api.ornek.com
VITE_API_URL=
